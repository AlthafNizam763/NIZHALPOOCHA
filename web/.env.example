# Socket.IO game server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Firebase web app config (Firebase console → Project settings → Your apps → Web)
# Leave NEXT_PUBLIC_FIREBASE_API_KEY empty to run in local dev mode (dev identities, no persistence).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# Google Analytics (optional) — measurementId from the same web app config.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local Firebase Emulator Suite (npm run emulators). When set, Auth/Firestore/RTDB use
# the emulators at this host. Use with NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-nizhalpoocha
# and any non-empty NEXT_PUBLIC_FIREBASE_API_KEY (e.g. demo-key). Leave empty otherwise.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=

# 'local' (default) keeps you signed in across restarts.
# 'session' gives every browser tab its own sign-in — handy for testing 5 players in one browser.
NEXT_PUBLIC_AUTH_PERSISTENCE=local
