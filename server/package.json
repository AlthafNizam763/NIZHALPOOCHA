{
  "name": "@nizhal/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --packages=external --alias:@nizhal/shared=../shared/src/index.ts --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "sim": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@nizhal/shared": "0.1.0",
    "ai": "^7.0.113",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "13.10.0",
    "socket.io": "4.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.10",
    "socket.io-client": "4.8.3",
    "tsx": "^4.20.6"
  }
}
