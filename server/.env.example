# Port the Socket.IO server listens on
PORT=4000

# Comma-separated list of allowed web origins (CORS). Include Capacitor origins for mobile.
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost

# Firebase Admin credentials (one of the two options):
#  1) Path to a service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=
#  2) Or the JSON itself, base64 encoded (handy on Render/Railway)
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=

# Local emulators (npm run emulators): the Admin SDK picks these up automatically.
# Set FIREBASE_PROJECT_ID=demo-nizhalpoocha and leave the service-account vars empty.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Local development only: accept unsigned dev identities when Firebase Admin is not
# configured. NEVER enable in production.
ALLOW_DEV_AUTH=true

# Set to true to reject new rooms with a MAINTENANCE error.
MAINTENANCE_MODE=false

LOG_LEVEL=info

# Voice chat (WebRTC). Public STUN is used by default. For players behind strict
# NATs/mobile carriers add a TURN server (e.g. coturn, Twilio, Cloudflare), as JSON:
# VOICE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
VOICE_ICE_SERVERS=
