{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged']) && newData.child('state').isString() && newData.child('state').val().matches(/^(online|in_lobby|in_game|offline)$/)"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
